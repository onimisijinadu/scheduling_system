exports.validateCourseInput = (req, res, next) => {
  const { course_code, course_title, credit_unit } = req.body;

  if (!course_code || !course_title || !credit_unit) {
    return res.status(400).json({ error: "Missing required course fields." });
  }

  if (typeof credit_unit !== "number" || credit_unit < 1) {
    return res
      .status(400)
      .json({ error: "Credit unit must be a positive number." });
  }

  next(); // Data is clean, move to the controller
};

