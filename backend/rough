// 6. ASSIGN LECTURER TO COURSE (Manage Lead & Co-Lecturers)
exports.assignLecturer = asyncErrorHandler(async (req, res, next) => {
  const { id: courseId } = req.params;
  const { lecturer_id, is_lead } = req.body;

  if (!lecturer_id) {
    return next(new customError("lecturer_id is required", 400));
  }

  // If assigning as lead lecturer, demote existing lead for this course first
  if (is_lead) {
    await pool.query(
      "UPDATE course_lecturers SET is_lead = FALSE WHERE course_id = $1",
      [courseId],
    );
  }

  const query = `
    INSERT INTO course_lecturers (course_id, lecturer_id, is_lead)
    VALUES ($1, $2, $3)
    ON CONFLICT (course_id, lecturer_id)
    DO UPDATE SET is_lead = EXCLUDED.is_lead
    RETURNING *;
  `;

  const result = await pool.query(query, [courseId, lecturer_id, is_lead || false]);

  res.status(200).json({
    status: "success",
    message: "Lecturer assigned to course successfully",
    data: {
      assignment: result.rows[0],
    },
  });
});

// 7. REMOVE LECTURER FROM COURSE
exports.removeLecturer = asyncErrorHandler(async (req, res, next) => {
  const { id: courseId, lecturerId } = req.params;

  const result = await pool.query(
    "DELETE FROM course_lecturers WHERE course_id = $1 AND lecturer_id = $2 RETURNING *",
    [courseId, lecturerId],
  );

  if (result.rowCount === 0) {
    return next(new customError("Assignment not found", 404));
  }

  res.status(200).json({
    status: "success",
    message: "Lecturer removed from course successfully",
    data: null,
  });
});




/**`c.*` (Select All From Table Alias)**

`c` is the alias for the `courses` table (`FROM courses c`).

Writing `c.*` selects **every column belonging strictly to the `courses` table** (`id`, `course_code`, `course_title`, `course_level`, `course_unit`, `total_enrolled`, `department_id`) without needing to type out each column name manually. It also ensures you don't accidentally pull conflicting columns from the joined `lecturers` or `users` tables.

---

**`COALESCE(...)` (Fallback Default Function)**

`COALESCE(value1, value2, ...)` returns the **first non-null value** in its argument list.

In your query:

```sql
COALESCE(
  json_agg(...) FILTER (WHERE l.id IS NOT NULL),
  '[]'
) AS lecturers

```

* **The Problem It Solves:** If a course is newly created and has **no lecturers assigned yet**, `json_agg(...)` evaluates to `NULL`.
* **How It Works:**
* If lecturers exist $\rightarrow$ returns the aggregated JSON array: `[{"lecturer_id": 1, ...}]`.
* If no lecturers exist (it evaluates to `NULL`) $\rightarrow$ `COALESCE` replaces the `NULL` with the fallback `'[]'` (an empty JSON array).



This ensures your React frontend always receives an array for `course.lecturers`, allowing you to run methods like `course.lecturers.map(...)` or `course.lecturers.length` without throwing a `TypeError: Cannot read properties of null` error.

*/